# Weights & Biases API Key (Optional if W&B disabled in config.yml)
WANDB_API_KEY=your_wandb_api_key_here

# Base Data Directory (Used by config.yml: ${LOCAL_PATH}/MIAF_DomainDetection_Infrastructure_Datasets/...)
LOCAL_PATH=/path/to/data

# Project Root and Custom Pretrained Model Paths (Optional)
PROJECT_ROOT=/path/to/miaff
URLBERT_MODEL_PATH=/path/to/urlbert_model

# Individual Dataset Root Overrides (Optional)
THREATFOX_MALWARE_BINARY=/path/to/ThreatFox/malware
MACFORMER_MALWARE_BINARY=/path/to/MACFormer/malware
DUBEN_MALWARE_BINARY=/path/to/DeepURLBench/malware
DIBHRAN_MALWARE_BINARY=/path/to/DataInBriefHranicky/malware
MACFORMER_PHISHING_BINARY=/path/to/MACFormer/phishing
DUBEN_PHISHING_BINARY=/path/to/DeepURLBench/phishing
DIBHRAN_PHISHING_BINARY=/path/to/DataInBriefHranicky/phishing
THREATFOX_MALWARE_FAMILY=/path/to/ThreatFox/malware_types
DIBHRAN_MALWARE_FAMILY=/path/to/DataInBriefHranicky/malware_classes
